--- Parses and formats HTTP cookies, signs their values, and adds them to
--- `web` applications.
---
--- `cookie.parse` reads a `Cookie` request header. `cookie.format` writes a
--- `Set-Cookie` response header. `cookie.sign` and `cookie.unsign` protect a
--- value with HMAC-SHA-256 from the standard library `crypto` module. As a
--- `web` plugin, the module adds `req.cookies` and `reply:cookie`.
---
--- @package cookie
--- @version 0.1.0
--- @lus 2.0
--- @license 0BSD
--- @repository https://github.com/lus-lang/atmos-cookie

local M = {}

local function unescape(text)
    if text:find("%", 1, true) == nil then
        return text
    end
    return (text:gsub("%%(%x%x)", function(hex) return string.char(tonumber(hex, 16)) end))
end

local function escape(text)
    return (text:gsub("[^%w!#$&'*+%-.^_`|~:/?@=]", function(c)
        return string.format("%%%02X", string.byte(c))
    end))
end

--- Parses the value of a `Cookie` header into a table from names to values.
---
--- Values are percent-decoded and lose surrounding double quotes. When a
--- name repeats, the first value wins, which matches the order in which
--- browsers send the most specific cookie first. A `nil` header gives an
--- empty table.
--- @param header string? The header value.
--- @return table
function M.parse(header)
    local out = {}
    if header == nil or header == "" then
        return out
    end
    for pair in header:gmatch("[^;]+") do
        local name, value = pair:match("^%s*([^=]-)%s*=%s*(.-)%s*$")
        if name and name ~= "" and out[name] == nil then
            if value:sub(1, 1) == '"' and value:sub(-1) == '"' and #value >= 2 then
                value = value:sub(2, -2)
            end
            out[name] = unescape(value)
        end
    end
    return out
end

local SAME_SITE = { strict = "Strict", lax = "Lax", none = "None" }

--- Formats a `Set-Cookie` header value.
---
--- The value is percent-encoded where a cookie may not hold a character.
--- `options` may hold `path`, `domain`, `max_age` in seconds, `expires` as
--- seconds since the epoch, `secure`, `http_only`, `same_site` (`"strict"`,
--- `"lax"`, or `"none"`), and `partitioned`. `same_site = "none"` sets
--- `Secure` as browsers require. A name with a character outside the token
--- characters of RFC 6265 raises an error.
--- @param name string The cookie name.
--- @param value string The value.
--- @param options table? The attributes.
--- @return string
function M.format(name, value, options)
    if not name:match("^[%w!#$%%&'*+%-.^_`|~]+$") then
        error(`invalid cookie name '$name'`, 2)
    end
    options = options or {}
    local parts = { name .. "=" .. escape(tostring(value)) }
    if options.max_age ~= nil then
        parts[#parts + 1] = "Max-Age=" .. math.floor(options.max_age)
    end
    if options.domain then
        parts[#parts + 1] = "Domain=" .. options.domain
    end
    if options.path then
        parts[#parts + 1] = "Path=" .. options.path
    end
    if options.expires then
        parts[#parts + 1] = "Expires=" .. os.date("!%a, %d %b %Y %H:%M:%S GMT", math.floor(options.expires))
    end
    if options.http_only then
        parts[#parts + 1] = "HttpOnly"
    end
    local same_site = options.same_site and SAME_SITE[options.same_site:lower()]
    if options.same_site and not same_site then
        error(`invalid same_site '$(options.same_site)'`, 2)
    end
    if options.secure or same_site == "None" then
        parts[#parts + 1] = "Secure"
    end
    if same_site then
        parts[#parts + 1] = "SameSite=" .. same_site
    end
    if options.partitioned then
        parts[#parts + 1] = "Partitioned"
    end
    return table.concat(parts, "; ")
end

local function mac(value, secret)
    if crypto == nil or crypto.hmac == nil then
        error("cookie signing needs the crypto module of Lus 2.0", 3)
    end
    local digest = string.transcode(crypto.hmac("sha256", secret, value), "binary", "base64")
    return (digest:gsub("=+$", ""):gsub("+", "-"):gsub("/", "_"))
end

--- Signs a value with HMAC-SHA-256 and returns `value.signature`.
--- @param value string The value.
--- @param secret string The secret key.
--- @return string
function M.sign(value, secret)
    return value .. "." .. mac(value, secret)
end

--- Checks a signed value and returns the original value.
---
--- Returns `nil` when the signature is missing or wrong. The signature is
--- compared in constant time. `secret` may be a list of secrets, which lets
--- a program rotate keys: the first signs new values and every one verifies.
--- @param signed string The signed value.
--- @param secret string|table The secret, or a list of secrets.
--- @return string?
function M.unsign(signed, secret)
    if type(signed) ~= "string" then
        return nil
    end
    local value, signature = signed:match("^(.*)%.([%w%-_]+)$")
    if value == nil then
        return nil
    end
    local secrets = type(secret) == "table" and secret or { secret }
    for _, s in ipairs(secrets) do
        if crypto.equal(mac(value, s), signature) then
            return value
        end
    end
    return nil
end

--- Registers the cookie plugin on a `web` scope.
---
--- Every request gets `req.cookies`, parsed from its `Cookie` header, and
--- every reply gets `reply:cookie(name, value, options)` and
--- `reply:clear_cookie(name, options)`. With `options.secret`,
--- `signed = true` in the attributes of `reply:cookie` signs the value and
--- `req.signed_cookies[name]` returns the checked value, or `false` when the
--- signature is wrong. The plugin applies to
--- the scope that registers it.
--- @param scope table The `web` scope.
--- @param options table? `secret` and `defaults`, the attributes every cookie gets.
function M.register(scope, options)
    options = options or {}
    local secret = options.secret
    local defaults = options.defaults or { path = "/" }
    scope:hook("on_request", function(req)
        local cookies = M.parse(req.headers.cookie)
        req.cookies = cookies
        if secret then
            req.signed_cookies = setmetatable({}, {
                __index = function(cache, name)
                    local value = M.unsign(cookies[name], secret)
                    if value == nil then
                        value = false
                    end
                    rawset(cache, name, value)
                    return value
                end,
            })
        end
    end)
    scope:decorate_reply("cookie", function(reply, name, value, attrs)
        local merged = {}
        for k, v in pairs(defaults) do
            merged[k] = v
        end
        for k, v in pairs(attrs or {}) do
            merged[k] = v
        end
        if merged.signed then
            if secret == nil then
                error("signed cookies need the secret option of the cookie plugin", 2)
            end
            value = M.sign(tostring(value), type(secret) == "table" and secret[1] or secret)
        end
        return reply:header("Set-Cookie", M.format(name, value, merged))
    end)
    scope:decorate_reply("clear_cookie", function(reply, name, attrs)
        local merged = { max_age = 0, expires = 0 }
        for k, v in pairs(defaults) do
            merged[k] = merged[k] or v
        end
        for k, v in pairs(attrs or {}) do
            merged[k] = v
        end
        return reply:header("Set-Cookie", M.format(name, "", merged))
    end)
end

--- Registers into the scope that calls `register`, so every route of that
--- scope sees the cookies.
M.shared = true

return M
